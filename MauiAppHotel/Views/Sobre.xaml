<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre o App"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    <Grid RowDefinitions="*, Auto">

        <VerticalStackLayout Grid.Row="0"
                             VerticalOptions="Center"
                             Padding="20"
                             Spacing="20">

            <Label Text="Sobre o Aplicativo"
                   FontFamily="ZenLoopRegular"
                   FontSize="55"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}" />

            <Frame Padding="25"
                   BackgroundColor="{StaticResource White}"
                   BorderColor="{StaticResource Gray200}"
                   CornerRadius="15"
                   HasShadow="True">

                <VerticalStackLayout Spacing="15">

                    <Label Text="MAUI Hotel"
                           FontAttributes="Bold"
                           FontSize="20"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="Versão 1.0"
                           FontSize="14"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Gray500}" />

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Gray200}"
                             Margin="0,5" />

                    <Grid RowDefinitions="Auto, Auto"
                          ColumnDefinitions="Auto, *"
                          RowSpacing="12"
                          ColumnSpacing="10">

                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Desenvolvido por:"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}" />

                        <Label Grid.Row="0" Grid.Column="1"
                               Text="Beatriz Silva Miranda Barreto"
                               TextColor="{StaticResource Primary}" />

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="Ano de Lançamento:"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}" />

                        <Label Grid.Row="1" Grid.Column="1"
                               Text="2026"
                               TextColor="{StaticResource Primary}" />
                    </Grid>

                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>

        <Button Grid.Row="1"
                Text="Voltar"
                Margin="20,0,20,25"
                TextColor="{StaticResource SecondaryDarkText}"
                BackgroundColor="{StaticResource Secondary}"
                Clicked="btn_voltar_Clicked" />

    </Grid>
</ContentPage>